{
  "name": "@fluxo-oficina/playground",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "npm run css && expo start",
    "export:ios": "npm run css && expo export --platform ios --output-dir dist-ios",
    "export:android": "npm run css && expo export --platform android --output-dir dist-android",
    "export:web": "npm run css && expo export --platform web --output-dir dist-web",
    "typecheck": "tsc --noEmit",
    "css": "node scripts-sync-css.mjs",
    "build": "npm run export:ios && npm run export:android && npm run export:web",
    "test:browser": "npm run export:web && playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@fluxo-oficina/native": "*",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.26",
    "expo-font": "~58.0.12",
    "expo-status-bar": "~58.0.5",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
