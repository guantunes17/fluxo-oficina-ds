      "secondary-foreground": "{neutro.50}",
      "muted": "{neutro.800}",
      "muted-foreground": "{neutro.300}",
      "accent": "{petroleo.900}",
      "accent-foreground": "{petroleo.100}",
      "destructive": "{vermelho.300}",
      "destructive-foreground": "{vermelho.900}",
      "border": "{neutro.800}",
      "input": "{neutro.500}",
      "ring": "{petroleo.400}",
      "success": "{verde.300}",
